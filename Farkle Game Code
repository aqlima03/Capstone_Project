import random
def roll_dice():
    dice = []

    for i in range(6):
        dice.append(random.randint(1, 6))
    return dice

def calculate_score(dice):
    score = 0

    """Count how many of each number was rolled"""
    counts = [0, 0, 0, 0, 0, 0, 0]
    
    for die in dice:
        counts[die - 1] = counts[die - 1] + 1

    """Check for three of a kind"""
    for number in range(1, 7):
        count = counts[number - 1]

        if count >= 3:

            if number == 1:
                score = score + 1000
            else:
                score = score + (number * 100)

            counts[number - 1] = counts[number - 1] - 3

    """Check for single 1s"""
    score = score + (counts[0] * 100)

    """Check for single 5s"""
    score = score + (counts[4] * 50)

    return score

def play_turn(total_score):
    turn_score = 0

    dice = roll_dice()

    while True:

        dice = roll_dice()

        print()
        print("You rolled: ", dice)

        points = calculate_score(dice)

        """No points scored, Farkle"""

        if points == 0:
            print("Farkle!")
            print("You scored 0 points this turn.")
            return total_score

        turn_score = turn_score + points

        print("Total points this roll: ", points)
        print("Points this turn: ", turn_score)
        print("Total points: ", total_score)

        choice = input("Do you want to roll again (r) or bank your points (b)? ")

        if choice == "b":
            total_score = total_score + turn_score
            
            print()
            print("You banked", turn_score, "points.")
            print("Total points: ", total_score)
            
            return total_score

        elif choice == "r":
            print()
            print("Rolling again...")

        else:
            print("Error. Please enter 'r' or 'b'.")


def play_game():
    total_score = 0

    print("Welcome to FARKLE!")
    print()
    print("The goal is to reach 3000 points.")
    print()
    print("Scoring:")
    print("1 = 100 points")
    print("5 = 50 points")
    print("Three 1s = 1000 points")
    print("Three of any other number = that number x 100 points")
    print()

    while total_score < 3000:

        print("Your current score is: ", total_score)

        total_score = play_turn(total_score)

    print()
    print("You Win!")
    print("Your final score is: ", total_score)

play_game()
